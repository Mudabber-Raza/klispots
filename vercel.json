{
  "buildCommand": "npm install --omit=optional --force && (npm run generate-sitemap || echo 'Sitemap generation failed, continuing build') && FULL_SSG=true NODE_ENV=production npm run build && echo 'Build completed successfully'",
  "outputDirectory": "dist", 
  "trailingSlash": false,
  "env": {
    "FULL_SSG": "true"
  },
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/restaurant/(.*)/index.html",
      "destination": "/restaurant/$1/index.html"
    },
    {
      "source": "/cafe/(.*)/index.html",
      "destination": "/cafe/$1/index.html"
    },
    {
      "source": "/shopping/(.*)/index.html",
      "destination": "/shopping/$1/index.html"
    },
    {
      "source": "/entertainment/(.*)/index.html",
      "destination": "/entertainment/$1/index.html"
    },
    {
      "source": "/arts-culture/(.*)/index.html",
      "destination": "/arts-culture/$1/index.html"
    },
    {
      "source": "/sports-fitness/(.*)/index.html",
      "destination": "/sports-fitness/$1/index.html"
    },
    {
      "source": "/health-wellness/(.*)/index.html",
      "destination": "/health-wellness/$1/index.html"
    },
    {
      "source": "/cities/(.*)/index.html",
      "destination": "/cities/$1/index.html"
    },
    {
      "source": "/about/index.html",
      "destination": "/about/index.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/sitemap-restaurants-1.xml",
      "destination": "/sitemap-restaurants-1.xml"
    },
    {
      "source": "/sitemap-restaurants-2.xml",
      "destination": "/sitemap-restaurants-2.xml"
    },
    {
      "source": "/sitemap-restaurants-3.xml",
      "destination": "/sitemap-restaurants-3.xml"
    },
    {
      "source": "/sitemap-cafes-1.xml",
      "destination": "/sitemap-cafes-1.xml"
    },
    {
      "source": "/sitemap-cafes-2.xml",
      "destination": "/sitemap-cafes-2.xml"
    },
    {
      "source": "/sitemap-shopping.xml",
      "destination": "/sitemap-shopping.xml"
    },
    {
      "source": "/sitemap-entertainment.xml",
      "destination": "/sitemap-entertainment.xml"
    },
    {
      "source": "/sitemap-arts-culture.xml",
      "destination": "/sitemap-arts-culture.xml"
    },
    {
      "source": "/sitemap-sports-fitness.xml",
      "destination": "/sitemap-sports-fitness.xml"
    },
    {
      "source": "/sitemap-health-wellness.xml",
      "destination": "/sitemap-health-wellness.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/(.*\\.html)",
      "destination": "/$1"
    },
    {
      "source": "/restaurant/(.*)",
      "destination": "/restaurant/$1/index.html"
    },
    {
      "source": "/cafe/(.*)",
      "destination": "/cafe/$1/index.html"
    },
    {
      "source": "/shopping/(.*)",
      "destination": "/shopping/$1/index.html"
    },
    {
      "source": "/entertainment/(.*)",
      "destination": "/entertainment/$1/index.html"
    },
    {
      "source": "/arts-culture/(.*)",
      "destination": "/arts-culture/$1/index.html"
    },
    {
      "source": "/sports-fitness/(.*)",
      "destination": "/sports-fitness/$1/index.html"
    },
    {
      "source": "/health-wellness/(.*)",
      "destination": "/health-wellness/$1/index.html"
    },
    {
      "source": "/cities/(.*)",
      "destination": "/cities/$1/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*\\.js)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*\\.css)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, immutable"
        }
      ]
    },
    {
